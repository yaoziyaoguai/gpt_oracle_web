+async function hasFocusedVisibleComposer(Runtime) {
+    const result = await Runtime.evaluate({
+        expression: `(() => {
+      const selectors = ${JSON.stringify(INPUT_SELECTORS)};
+      const isVisible = (node) => {
+        if (!node || typeof node.getBoundingClientRect !== 'function') return false;
+        const rect = node.getBoundingClientRect();
+        return rect.width > 0 && rect.height > 0;
+      };
+      const isEditable = (node) =>
+        node instanceof HTMLTextAreaElement ||
+        node instanceof HTMLInputElement ||
+        node.isContentEditable ||
+        node.getAttribute?.('contenteditable') === 'true';
+      const active = document.activeElement;
+      if (!(active instanceof Node)) return false;
+      const primary = document.querySelector(${JSON.stringify(PROMPT_PRIMARY_SELECTOR)});
+      const candidates = [
+        primary,
+        ...selectors.flatMap((selector) => Array.from(document.querySelectorAll(selector))),
+      ].filter((node, index, all) => node && all.indexOf(node) === index);
+      return candidates.some((node) =>
+        isVisible(node) &&
+        isEditable(node) &&
+        (node === active || node.contains(active))
+      );
+    })()`,
+        returnByValue: true,
+    });
+    return result.result?.value === true;
+}
