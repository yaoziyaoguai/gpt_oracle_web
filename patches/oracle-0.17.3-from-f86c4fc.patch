+function createBrowserRunDeadline(timeoutMs) {
+    let expired = false;
+    let timer;
+    const normalizedTimeoutMs = Math.max(1, Number(timeoutMs) || 1);
+    const promise = new Promise((_, reject) => {
+        timer = setTimeout(() => {
+            expired = true;
+            reject(new Error("browser-run-deadline-exceeded"));
+        }, normalizedTimeoutMs);
+    });
+    // The deadline can fire while a non-raced setup operation is still resolving.
+    // Keep the rejection handled until the main browser race observes it.
+    promise.catch(() => undefined);
+    return {
+        promise,
+        get expired() {
+            return expired;
+        },
+        dispose() {
+            if (timer) {
+                clearTimeout(timer);
+                timer = undefined;
+            }
+        },
+    };
+}
