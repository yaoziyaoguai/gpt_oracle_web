#!/usr/bin/env bash
set -euo pipefail

oracle_bin="${ORACLE_WEB_ORACLE_BIN:-}"
if [[ -z "$oracle_bin" ]]; then
  oracle_bin="$(command -v oracle || true)"
fi
if [[ -z "$oracle_bin" || ! -x "$oracle_bin" ]]; then
  echo "oracle-web: Oracle CLI not found. Set ORACLE_WEB_ORACLE_BIN or install @steipete/oracle 0.17.3." >&2
  exit 69
fi
if [[ "$(basename "$oracle_bin")" == "oracle-web" ]]; then
  echo "oracle-web: ORACLE_WEB_ORACLE_BIN resolves to this wrapper; point it to the upstream oracle executable." >&2
  exit 64
fi

state_root="${XDG_STATE_HOME:-$HOME/.local/state}"
session_dir="${ORACLE_WEB_SESSION_DIR:-$state_root/oracle-web}"
chrome_user_data_dir="${ORACLE_WEB_CHROME_USER_DATA_DIR:-$HOME/Library/Application Support/Google/Chrome}"
chrome_profile="${ORACLE_WEB_CHROME_PROFILE:-Default}"
requested_model="${ORACLE_WEB_REQUEST_MODEL:-gpt-5.6-sol}"
session_retention_hours="${ORACLE_WEB_SESSION_RETENTION_HOURS:-24}"

if [[ "${1:-}" == "--doctor" ]]; then
  [[ "$#" -eq 1 ]] || {
    echo "oracle-web: --doctor does not accept consultation arguments." >&2
    exit 64
  }

  wrapper_path="${BASH_SOURCE[0]}"
  if [[ "$wrapper_path" != /* ]]; then
    wrapper_path="$(CDPATH= cd -- "$(dirname -- "$wrapper_path")" && pwd -P)/$(basename -- "$wrapper_path")"
  fi

  doctor_status=0
  profile_dir="$chrome_user_data_dir/$chrome_profile"
  cookie_db="missing"
  if [[ -f "$profile_dir/Network/Cookies" ]]; then
    cookie_db="Network/Cookies"
  elif [[ -f "$profile_dir/Cookies" ]]; then
    cookie_db="Cookies"
  fi

  [[ -d "$chrome_user_data_dir" ]] || doctor_status=1
  [[ -f "$chrome_user_data_dir/Local State" ]] || doctor_status=1
  [[ -d "$profile_dir" ]] || doctor_status=1
  [[ "$cookie_db" != "missing" ]] || doctor_status=1

  printf '%s\n' \
    "oracle-web doctor" \
    "wrapper=$wrapper_path" \
    "oracle=$oracle_bin" \
    "chromeUserDataDir=$chrome_user_data_dir" \
    "chromeProfile=$chrome_profile" \
    "profileDir=$profile_dir" \
    "cookieDb=$cookie_db" \
    "loginState=not-tested"

  if [[ "$doctor_status" -ne 0 ]]; then
    echo "oracle-web: doctor failed; the configured Chrome profile is incomplete or unavailable." >&2
    exit 78
  fi
  exit 0
fi

thinking_time_configured=false
attachment_timeout_configured=false
retention_configured=false
timeout_configured=false
browser_timeout_configured=false
for argument in "$@"; do
  case "$argument" in
    --browser-keep-browser|--browser-keep-browser=*|\
    --browser-tab|--browser-tab=*|\
    --browser-attach-running|--browser-attach-running=*|\
    --browser-chrome-profile|--browser-chrome-profile=*|\
    --copy-profile|--copy-profile=*|\
    --browser-manual-login|--browser-manual-login=*|\
    --browser-manual-login-profile-dir|--browser-manual-login-profile-dir=*|\
    --browser-manual-login-cookie-sync|--browser-manual-login-cookie-sync=*|\
    --browser-cookie-path|--browser-cookie-path=*|\
    --browser-inline-cookies|--browser-inline-cookies=*|\
    --browser-inline-cookies-file|--browser-inline-cookies-file=*|\
    --followup|--followup=*|\
    --browser-follow-up|--browser-follow-up=*)
      echo "oracle-web: $argument overrides wrapper-owned browser identity or state; configure the wrapper environment instead." >&2
      exit 64
      ;;
    --browser-thinking-time|--browser-thinking-time=*)
      thinking_time_configured=true
      ;;
    --browser-attachment-timeout|--browser-attachment-timeout=*)
      attachment_timeout_configured=true
      ;;
    --retain-hours|--retain-hours=*)
      retention_configured=true
      ;;
    --timeout|--timeout=*)
      timeout_configured=true
      ;;
    --browser-timeout|--browser-timeout=*)
      browser_timeout_configured=true
      ;;
  esac
done

oracle_args=(
  --engine browser
  --model "$requested_model"
  --browser-model-strategy current
  --browser-chrome-profile "$chrome_profile"
)

if [[ "$thinking_time_configured" == false ]]; then
  oracle_args+=(--browser-thinking-time extra-high)
fi

if [[ "$attachment_timeout_configured" == false ]]; then
  oracle_args+=(--browser-attachment-timeout 300s)
fi

if [[ "$retention_configured" == false ]]; then
  oracle_args+=(--retain-hours "$session_retention_hours")
fi

if [[ "$timeout_configured" == false ]]; then
  oracle_args+=(--timeout 45m)
fi

if [[ "$browser_timeout_configured" == false ]]; then
  oracle_args+=(--browser-timeout 45m)
fi

oracle_args+=(
  --copy-profile "$chrome_user_data_dir"
  --browser-archive never
)

mkdir -p "$session_dir"

ORACLE_HOME_DIR="$session_dir" \
exec "$oracle_bin" "${oracle_args[@]}" "$@"
